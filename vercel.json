{
  "version": 2,
  "buildCommand": "cd frontend && npm install --include=optional && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://121.241.29.115:5050/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://121.241.29.115:5050/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://121.241.29.115:5050/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}